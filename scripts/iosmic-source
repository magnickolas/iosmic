#!/usr/bin/env bash
set -Eeuo pipefail

SOURCE_NAME="${IOSMIC_SOURCE_NAME:-ios_mic}"
SINK_NAME="${IOSMIC_SINK_NAME:-}"
DEVICE="${IOSMIC_DEVICE:-pulse}"
CHILD_PID=""
SINK_MODULE_ID=""
SOURCE_MODULE_ID=""
BINARY="${IOSMIC_BINARY:-iosmic}"

usage() {
    cat <<EOF
Usage: scripts/iosmic-source [OPTIONS] [-- IOSMIC OPTIONS]

Create a temporary PulseAudio/PipeWire source, run iosmic into its backing sink,
then unload only the modules this script created.

Options:
  --source-name NAME   App-facing source name [default: ios_mic]
  --sink-name NAME     Backing sink name [default: <source-name>_sink]
  --device DEVICE      ALSA device passed to iosmic [default: pulse]
  --binary PATH        iosmic binary [default: ./target/release/iosmic]
  -h, --help           Print help

Examples:
  scripts/iosmic-source -- --buffer 50
  scripts/iosmic-source --source-name iPhoneMic -- --host 192.168.0.114 --buffer 50
EOF
}

die() {
    echo "iosmic-source: $*" >&2
    exit 2
}

valid_name() {
    [[ "$1" =~ ^[A-Za-z0-9_.-]+$ ]]
}

pactl_has_name() {
    local kind="$1"
    local name="$2"

    pactl list short "$kind" | awk -v name="$name" '$2 == name { found = 1 } END { exit !found }'
}

cleanup() {
    set +e

    if [[ -n "$SOURCE_MODULE_ID" ]]; then
        pactl unload-module "$SOURCE_MODULE_ID" >/dev/null 2>&1
    fi

    if [[ -n "$SINK_MODULE_ID" ]]; then
        pactl unload-module "$SINK_MODULE_ID" >/dev/null 2>&1
    fi
}

stop_child_and_exit() {
    local signal="$1"
    local status="$2"
    set +e

    if [[ -n "$CHILD_PID" ]] && kill -0 "$CHILD_PID" 2>/dev/null; then
        kill "-$signal" "$CHILD_PID" 2>/dev/null
        wait "$CHILD_PID" 2>/dev/null
    fi

    exit "$status"
}

trap cleanup EXIT
trap 'stop_child_and_exit INT 130' INT
trap 'stop_child_and_exit TERM 143' TERM

while [[ $# -gt 0 ]]; do
    case "$1" in
        --source-name)
            [[ $# -ge 2 ]] || die "--source-name requires a value"
            SOURCE_NAME="$2"
            shift 2
            ;;
        --sink-name)
            [[ $# -ge 2 ]] || die "--sink-name requires a value"
            SINK_NAME="$2"
            shift 2
            ;;
        --device)
            [[ $# -ge 2 ]] || die "--device requires a value"
            DEVICE="$2"
            shift 2
            ;;
        --binary)
            [[ $# -ge 2 ]] || die "--binary requires a value"
            BINARY="$2"
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown script option: $1"
            ;;
        *)
            break
            ;;
    esac
done

for arg in "$@"; do
    case "$arg" in
        -D | --device | --device=*)
            die "pass the output device to this script with --device, not to iosmic"
            ;;
    esac
done

[[ -n "$SINK_NAME" ]] || SINK_NAME="${SOURCE_NAME}_sink"
valid_name "$SOURCE_NAME" || die "source name may only contain ASCII letters, numbers, '.', '_', and '-'"
valid_name "$SINK_NAME" || die "sink name may only contain ASCII letters, numbers, '.', '_', and '-'"
command -v pactl >/dev/null 2>&1 || die "pactl is required"
[[ -x "$BINARY" ]] || die "iosmic binary is not executable: $BINARY"

if pactl_has_name sinks "$SINK_NAME"; then
    die "sink already exists, refusing to manage it: $SINK_NAME"
fi

if pactl_has_name sources "$SOURCE_NAME"; then
    die "source already exists, refusing to manage it: $SOURCE_NAME"
fi

SINK_MODULE_ID="$(
    pactl load-module module-null-sink \
        "sink_name=$SINK_NAME" \
        "sink_properties=device.description=$SINK_NAME"
)"

SOURCE_MODULE_ID="$(
    pactl load-module module-remap-source \
        "master=$SINK_NAME.monitor" \
        "source_name=$SOURCE_NAME" \
        "source_properties=device.description=$SOURCE_NAME"
)"

echo "Created source '$SOURCE_NAME' backed by sink '$SINK_NAME'" >&2
echo "Select '$SOURCE_NAME' as the microphone in applications." >&2

PULSE_SINK="$SINK_NAME" "$BINARY" "$@" --device "$DEVICE" &
CHILD_PID="$!"

status=0
wait "$CHILD_PID" || status="$?"
CHILD_PID=""
exit "$status"
